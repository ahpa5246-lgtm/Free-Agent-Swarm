{
  "name": "Dispatch a bounded free AI coding task to GitHub Actions",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "swarm-free-coding",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f1d46a4f-3539-4eed-b99e-bd7e41d15ba1",
      "name": "Private Task Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        260
      ],
      "webhookId": "d8e8490b-1644-4c8b-a7f4-d31e0438394d"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/ahpa5246-lgtm/Free-Agent-Swarm/actions/workflows/real-free-agents.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ref: \"main\", inputs: { task: $json.task, target_path: $json.target_path, confirm_free_tier: true } }) }}",
        "options": {
          "timeout": 12000
        }
      },
      "id": "3bf32799-00c5-45c7-a295-2e4d37d23f80",
      "name": "Dispatch to Free GitHub Runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":true,\"execution\":\"GitHub Actions workflow_dispatch\",\"notice\":\"Not a completed coding task: check the workflow run and draft PR.\"}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "72cfb824-86e1-4cf8-8fed-c73e93f3ade4",
      "name": "Return Accepted, Not Completed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\nconst target = body.target_path;\nconst task = body.task;\nconst pathOk = typeof target === 'string'\n  && target.length <= 180 && !target.includes('\\\\')\n  && !target.includes('//') && !target.split('/').some(part => !part || part.startsWith('.'))\n  && (/^(src|docs)\\/[a-zA-Z0-9/_\\-.]+$/.test(target) || target === 'index.html')\n  && /\\.(mjs|js|ts|tsx|css|html|md|json|svg)$/i.test(target)\n  && !target.startsWith('src/real/');\nconst taskOk = typeof task === 'string' && task.trim().length > 0\n  && task.length <= 750 && !/[\\x00-\\x08\\x0b-\\x1f]/.test(task);\nreturn { json: { valid: body.confirm_free_tier === true && pathOk && taskOk,\n  target_path: pathOk ? target : '', task: taskOk ? task : '' } };"
      },
      "id": "c2955099-a63a-49aa-bd9f-96f5477564c2",
      "name": "Validate Private Dispatch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "08ea3983-3e7d-45a0-8905-c5785a46cf5b",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "741dfc15-c531-48ea-b5b7-65a39efed562",
      "name": "Only Confirmed Safe Tasks",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        560,
        260
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":false,\"error\":\"Invalid target/task or explicit free-tier confirmation missing. No GitHub dispatch was attempted.\"}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "3db92ec2-d042-4725-ae2c-d118fbcd7b0a",
      "name": "Reject Unsafe Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        820,
        440
      ]
    }
  ],
  "connections": {
    "Private Task Webhook": {
      "main": [
        [
          {
            "node": "Validate Private Dispatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch to Free GitHub Runner": {
      "main": [
        [
          {
            "node": "Return Accepted, Not Completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Private Dispatch": {
      "main": [
        [
          {
            "node": "Only Confirmed Safe Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only Confirmed Safe Tasks": {
      "main": [
        [
          {
            "node": "Dispatch to Free GitHub Runner",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Unsafe Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "tags": [],
  "pinData": {}
}
